# ==============================================================================
# SwasthiQ Front-Desk Agent - Environment Configuration Template
# ==============================================================================

# LLM Providers (Multi-tier Failover Architecture)
# Primary: Google Gemini (Free tier with generous limits: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary Fallback: Groq Cloud (Free tier ultra-fast inference: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=

# Model Names
MODEL_NAME=gemini-2.5-flash
GROQ_MODEL=qwen/qwen3.8-27b

# Clinic Database / Config (Defaults to in-memory SQLite seeded from clinic.json)
CLINIC_JSON_PATH=swasthiq-front-desk-agent-starter-pack/clinic.json
DB_PATH=:memory:
